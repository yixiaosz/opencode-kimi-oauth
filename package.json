{
  "name": "opencode-kimi-oauth",
  "version": "1.5.0",
  "description": "OpenCode plugin that brings the official Kimi OAuth device flow and Kimi-specific coding request fields to opencode, matching upstream kimi-cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yixiaosz/opencode-kimi-oauth.git"
  },
  "homepage": "https://github.com/yixiaosz/opencode-kimi-oauth#readme",
  "bugs": {
    "url": "https://github.com/yixiaosz/opencode-kimi-oauth/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kimi",
    "kimi-for-coding",
    "moonshot",
    "oauth",
    "device-flow",
    "reasoning-effort",
    "prompt-cache-key"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.6",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "engines": {
    "opencode": ">=1.4.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.7",
    "@opentui/core": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
